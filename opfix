#!/usr/bin/env bash

# Opiumware v2.2.0 — Installer
# Troubleshooter made by dior (trial-support king)

set -euo pipefail
IFS=$'\n\t'

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

CHECK="${GREEN}✔${NC}"
CROSS="${RED}✖${NC}"
INFO="${CYAN}➜${NC}"
WARN="${YELLOW}⚠${NC}"

DYLIB_ARM_URL="https://x099xkycxe.ufs.sh/f/ar75CUBjeUn9UMEK7h1281VjsWY4ORpKNanuXg9Ltewrkz7C"
DYLIB_X86_URL="https://x099xkycxe.ufs.sh/f/ar75CUBjeUn907ZDaL9RvnwtPqsyrWQGdUaCf8TDJlbXuYZ3"
MODULES_URL="https://x099xkycxe.ufs.sh/f/ar75CUBjeUn9sVKnsuNRLpwIiVkxYvTUQnAuFbGoSEH1tPMO"
UI_URL="https://x099xkycxe.ufs.sh/f/ar75CUBjeUn9SqRVN7ZrzmeZJ1BNkhvFnjVlg3PaHqYESfiU"

DEBUG=0
[[ "${1:-}" == "--debug" ]] && DEBUG=1

dbg()  { [[ "$DEBUG" -eq 1 ]] && echo -e "${YELLOW}[DBG]${NC} $*" || true; }
step() { echo -e "\n${BOLD}${CYAN}==> $1${NC}"; }
ok()   { echo -e "${CHECK} $1"; }
info() { echo -e "${INFO} $1"; }
warn() { echo -e "${WARN} $1"; }
fail() { echo -e "${CROSS} ${RED}$1${NC}"; exit 1; }

verify_signed() {
    local path="$1"
    if codesign -v "$path" 2>/dev/null; then
        ok "$(basename "$path") — signed"
    else
        echo -e "${CROSS} ${RED}$(basename "$path") is UNSIGNED — aborting${NC}"
        codesign -dvv "$path" 2>&1 | sed "s/^/  /"
        exit 1
    fi
}

safe_remove() {
    local target="$1"
    if [ ! -e "$target" ]; then
        info "$(basename "$target") not present, skipping"
        return 0
    fi
    info "Removing $(basename "$target")..."
    if rm -rf "$target" 2>/dev/null; then
        ok "Removed $target"
        return 0
    fi
    # rm failed — files inside may be root-owned; try sudo
    echo -e "${INFO} Requires elevated privileges to remove $(basename "$target")..."
    if sudo rm -rf "$target"; then
        ok "Removed $target (sudo)"
    else
        fail "Could not remove $target — delete it manually and rerun"
    fi
}

if [ -w "/Applications" ]; then
    APP_DIR="/Applications"
else
    APP_DIR="$HOME/Applications"
    mkdir -p "$APP_DIR"
fi

TEMP="$(mktemp -d)"
dbg "Temp dir: $TEMP"

cleanup() {
    local code=$?
    if [[ $code -ne 0 ]]; then
        echo -e "\n${RED}${BOLD}Installation failed (exit $code)${NC}"
        warn "Temp dir kept for inspection: $TEMP"
    else
        rm -rf "$TEMP"
    fi
}
trap cleanup EXIT

# ── Banner ────────────────────────────────────────────────────────────────────
clear
echo -e "${BOLD}"
cat <<'EOF'
